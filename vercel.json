{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_lib/**"
    }
  },
  "rewrites": [
    {
      "source": "/auth/action",
      "destination": "/index.html"
    },
    {
      "source": "/__/auth/action",
      "destination": "/index.html"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://arixonstudents-d902a.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://arixonstudents-d902a.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
