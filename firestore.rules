rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('role', '') == 'admin' ||
        (request.auth.token.email != null && (
          request.auth.token.email in [
            'omar88x99@gmail.com',
            'omarkingx99@gmail.com',
            'omarkingx98@gmail.com'
          ] ||
          request.auth.token.email.lower() in [
            'omar88x99@gmail.com',
            'omarkingx99@gmail.com',
            'omarkingx98@gmail.com'
          ]
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'admin']) ||
        exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid))
      );
    }

    // User profiles & student records
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for leaderboard and rankings)
      allow read: if isAuthenticated();

      // Only admins or the owner with student role can create a profile
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'student') == 'student' &&
        request.resource.data.get('accountDisabled', false) == false
      );

      // Admins have full update rights (points, freeze, roles).
      // Students can only update their profile info and cannot elevate their role or alter account freeze
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'accountDisabled', 'disabledReason', 'disabledAt'
        ])
      );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Student daily goals subcollection
      match /dailyGoals/{goalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin Profiles
    match /adminProfiles/{adminUid} {
      allow read, write: if isAdmin();
    }

    // Admin Audit Logs (Append-Only)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Point Adjustments History (Append-Only)
    match /pointAdjustments/{adjId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Central Question Bank (Admin only)
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Global Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Exams
    match /exams/{examId} {
      // Students can read published exams; Admins can read both draft & published exams
      allow read: if isAuthenticated() && (
        resource.data.published == true ||
        isAdmin()
      );

      // Only admins can create, update, or publish exams
      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      // Public question data
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      // Protected answer keys - hidden from regular students, accessible only to admin
      match /answerKeys/{questionId} {
        allow read, write: if isAdmin();
      }
    }

    // AI Generation Jobs (Admin only)
    match /aiGenerationJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // Exam Templates (Admin only)
    match /examTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Exam attempts
    match /attempts/{attemptId} {
      // Students can read their own attempts; admins can inspect any attempt
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Students can create an attempt for themselves
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      
      // Students can update their attempt while in_progress (saving answers or submitting)
      // Once status is 'submitted', attempt results are locked and only admin can adjust
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && resource.data.status == 'in_progress')
      );
        
      allow delete: if isAdmin();

      // Subcollection for answers during attempt
      match /answers/{questionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isAuthenticated() && (
          isAdmin() ||
          (get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid &&
           get(/databases/$(database)/documents/attempts/$(attemptId)).data.status == 'in_progress')
        );
        allow delete: if isAdmin();
      }
    }
  }
}
