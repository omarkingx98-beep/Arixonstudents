rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.get('role', '') == 'super_admin' ||
        request.auth.token.get('role', '') == 'admin' ||
        request.auth.token.get('email', '') in [
          'omar88x99@gmail.com',
          'omarkingx99@gmail.com',
          'omarkingx98@gmail.com'
        ] ||
        request.auth.token.get('email', '').lower() in [
          'omar88x99@gmail.com',
          'omarkingx99@gmail.com',
          'omarkingx98@gmail.com'
        ] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'admin']) ||
        exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid))
      );
    }

    // User profiles & student records
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for leaderboard and rankings)
      allow read: if isAuthenticated();

      // Only admins or the owner with student role can create a profile
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'student') == 'student' &&
        request.resource.data.get('accountDisabled', false) == false
      );

      // Admins have full update rights (points, freeze, roles, branch).
      // Students can update their profile info and choose/switch their branch (علمي / أدبي / مشترك), but:
      // - Cannot change role, accountDisabled, disabledReason, disabledAt, chatDisabled
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'accountDisabled', 'disabledReason', 'disabledAt', 'chatDisabled'
        ])
      );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Student daily goals subcollection
      match /dailyGoals/{goalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Student notification metadata (lastReadAt timestamp for broadcast counter)
      match /meta/notifState {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Public Profiles (Limited safe data for student search and profile view - E3 & E4)
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'avatar', 'photoURL',
          'track', 'branch', 'points', 'totalPoints', 'weeklyPoints', 'monthlyPoints',
          'examsCompleted', 'correctAnswers', 'wrongAnswers', 'createdAt', 'updatedAt', 'age'
        ])
      );
      allow delete: if isAdmin();
    }

    // Reports Collection (E4: reporterId, reportedId, reason, note, createdAt, status)
    match /reports/{reportId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.reporterId == request.auth.uid && 
        request.resource.data.reporterId != request.resource.data.reportedId;
      allow update, delete: if isAdmin();
    }

    // Admin Profiles
    match /adminProfiles/{adminUid} {
      allow read, write: if isAdmin();
    }

    // Admin Audit Logs (Append-Only)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Admin Reports & Block Alerts (Legacy / direct alerts)
    match /adminReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Point Adjustments History (Append-Only)
    match /pointAdjustments/{adjId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Central Question Bank (Admin only)
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // Global Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Direct in-app notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Broadcast Notifications
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Friend Requests (E4 & E5)
    match /friendRequests/{reqId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderId != request.resource.data.receiverId;
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // Realtime 1:1 Chats & Unread Counters (E6)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        chatId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        (isAdmin() && resource.data.get('reported', false) == true)
      );
      allow create: if isAuthenticated() && (
        chatId.matches('.*' + request.auth.uid + '.*') ||
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*')
      );
      allow delete: if isAdmin();

      // Chat Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) && 
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          isAdmin()
        );
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid && (
            chatId.matches('.*' + request.auth.uid + '.*') ||
            (exists(/databases/$(database)/documents/chats/$(chatId)) && 
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
            isAdmin()
          );
        allow update: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // Exams
    match /exams/{examId} {
      allow read: if isAuthenticated() && (
        (resource.data.published == true && 
         resource.data.get('status', 'available') != 'unpublished' && 
         resource.data.get('status', 'available') != 'archived' && 
         resource.data.get('status', 'available') != 'draft') ||
        isAdmin()
      );

      allow create, update: if isAdmin();
      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isAdmin();
      }

      match /answerKeys/{questionId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // AI Generation Jobs (Admin only)
    match /aiGenerationJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // Exam Templates (Admin only)
    match /examTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Exam attempts
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.userId == request.auth.uid && resource.data.status == 'in_progress')
      );
      allow delete: if isAdmin();

      match /answers/{questionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid ||
          isAdmin()
        );
        allow create, update: if isAuthenticated() && (
          isAdmin() ||
          (get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid &&
           get(/databases/$(database)/documents/attempts/$(attemptId)).data.status == 'in_progress')
        );
        allow delete: if false;
      }
    }
  }
}
