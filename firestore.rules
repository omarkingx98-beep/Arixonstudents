rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getRole() {
      return request.auth.token.get('role', 'student');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getRole() == 'super_admin' ||
        request.auth.token.get('email', '').lower() in [
          'omar88x99@gmail.com',
          'omarkingx99@gmail.com',
          'omarkingx98@gmail.com'
        ]
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getRole() == 'admin' ||
        request.auth.token.get('admin', false) == true ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') in ['super_admin', 'admin']) ||
        exists(/databases/$(database)/documents/adminProfiles/$(request.auth.uid))
      );
    }

    function hasRole(roles) {
      return isAuthenticated() && (
        isSuperAdmin() ||
        getRole() in roles
      );
    }

    function isStaff() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        isAdmin() ||
        request.auth.token.get('staff', false) == true ||
        getRole() in ['moderator', 'content_editor', 'community_manager', 'support_agent']
      );
    }

    // Staff Directory (Private)
    match /staff/{staffUid} {
      allow read: if isStaff();
      allow write: if isSuperAdmin();
    }

    // Public Staff Badges (Read for authenticated, server write only)
    match /staffBadges/{targetUid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User profiles & student records
    match /users/{userId} {
      // Anyone authenticated can read user profiles (for leaderboard and rankings)
      allow read: if isAuthenticated();

      // Only admins or the owner with student role can create a profile
      allow create: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', 'student') == 'student' &&
        request.resource.data.get('accountDisabled', false) == false
      );

      // Admins have full update rights (points, freeze, roles, branch).
      // Students can update their profile info and choose/switch their branch (علمي / أدبي / مشترك), but:
      // - Cannot change role, accountDisabled, disabledReason, disabledAt, chatDisabled, mutedUntil
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'accountDisabled', 'disabledReason', 'disabledAt', 'chatDisabled', 'mutedUntil'
        ])
      );

      // Only admins can delete profiles
      allow delete: if isAdmin();

      // Student daily goals subcollection
      match /dailyGoals/{goalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Student notification metadata (lastReadAt timestamp for broadcast counter)
      match /meta/notifState {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // High-resolution user avatars (Part N: Canvas compressed < 60KB in Firestore, no storage)
    match /avatars/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly(['full', 'updatedAt']) &&
        request.resource.data.full is string &&
        request.resource.data.full.size() <= 60000
      );
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Public Profiles (Limited safe data for student search and profile view - E3, E4, Part N)
    match /publicProfiles/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'username', 'usernameLower', 'avatar', 'photoURL',
          'track', 'branch', 'points', 'totalPoints', 'weeklyPoints', 'monthlyPoints',
          'examsCompleted', 'correctAnswers', 'wrongAnswers', 'createdAt', 'updatedAt', 'age'
        ]) &&
        request.resource.data.get('avatar', '').size() <= 8000
      );
      allow delete: if isAdmin();
    }

    // Reports & Complaints Collection (E4 & Part M)
    match /reports/{reportId} {
      allow read: if isSuperAdmin() || isAdmin() || hasRole(['moderator', 'support_agent']) || 
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.reporterId == request.auth.uid;
      allow update, delete: if isSuperAdmin() || isAdmin() || hasRole(['moderator', 'support_agent']);

      // Immutable chat evidence snapshot
      match /evidence/{msgId} {
        allow read: if isSuperAdmin() || isAdmin() || hasRole(['moderator']);
        allow write: if false;
      }
    }

    // Moderation Actions Record
    match /moderationActions/{actionId} {
      allow read, write: if isSuperAdmin() || isAdmin() || hasRole(['moderator']);
    }

    // Admin Profiles
    match /adminProfiles/{adminUid} {
      allow read, write: if isAdmin();
    }

    // Admin Audit Logs (Append-Only)
    match /adminAuditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Admin Reports & Block Alerts (Legacy / direct alerts)
    match /adminReports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if isAuthenticated();
    }

    // Point Adjustments History (Append-Only)
    match /pointAdjustments/{adjId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Central Question Bank (Admin & Content Editor)
    match /questions/{questionId} {
      allow read, write: if isAdmin() || hasRole(['content_editor']);
    }

    // Global Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Announcements
    match /announcements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole(['community_manager']);
    }

    // Dynamic App Announcements (New unified collection for ticker & image ads)
    match /appAnnouncements/{announcementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole(['community_manager']);
    }

    // Promotional Carousel Banners (Part G)
    match /promoBanners/{bannerId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole(['community_manager']);
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole(['community_manager']);
    }

    // Direct in-app notifications
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.senderId == request.auth.uid ||
        request.resource.data.recipientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Broadcast Notifications
    match /broadcasts/{broadcastId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasRole(['community_manager']);
    }

    // Friend Requests (E4 & E5)
    match /friendRequests/{reqId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && 
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderId != request.resource.data.receiverId;
      allow update, delete: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid ||
        isAdmin()
      );
    }

    // Realtime 1:1 Chats & Unread Counters (E6)
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (
        chatId.matches('.*' + request.auth.uid + '.*') ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        (isAdmin() && resource.data.get('reported', false) == true) ||
        hasRole(['moderator'])
      );
      allow create: if isAuthenticated() && (
        chatId.matches('.*' + request.auth.uid + '.*') ||
        request.auth.uid in request.resource.data.participants ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (resource != null && request.auth.uid in resource.data.participants) ||
        chatId.matches('.*' + request.auth.uid + '.*')
      );
      allow delete: if isAdmin();

      // Chat Messages
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) && 
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          isAdmin() ||
          hasRole(['moderator'])
        );
        allow create: if isAuthenticated() && 
          request.resource.data.senderId == request.auth.uid && (
            chatId.matches('.*' + request.auth.uid + '.*') ||
            (exists(/databases/$(database)/documents/chats/$(chatId)) && 
             request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
            isAdmin()
          ) && (
            !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('chatDisabled', false) == false
          );
        allow update: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          isAdmin()
        );
        allow delete: if isSuperAdmin() || isAdmin() || hasRole(['moderator']);
      }

      // Typing Presence (Part L: chats/{chatId}/presence/{userId})
      match /presence/{userId} {
        allow read: if isAuthenticated() && (
          chatId.matches('.*' + request.auth.uid + '.*') ||
          (exists(/databases/$(database)/documents/chats/$(chatId)) && 
           request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants) ||
          isAdmin()
        );
        allow create, update, delete: if isAuthenticated() && (
          request.auth.uid == userId || isAdmin()
        );
      }
    }

    // Exams
    match /exams/{examId} {
      allow read: if isAuthenticated() && (
        (resource.data.published == true && 
         resource.data.get('status', 'available') != 'unpublished' && 
         resource.data.get('status', 'available') != 'archived' && 
         resource.data.get('status', 'available') != 'draft') ||
        isAdmin() ||
        hasRole(['content_editor'])
      );

      allow create: if isAdmin() || (
        hasRole(['content_editor']) &&
        request.resource.data.get('published', false) == false
      );

      allow update: if isAdmin() || (
        hasRole(['content_editor']) &&
        (resource.data.get('published', false) == false || request.resource.data.get('status', 'draft') in ['draft', 'pending_review'])
      );

      allow delete: if isAdmin();

      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin() || hasRole(['content_editor']);
        allow delete: if isAdmin();
      }

      match /answerKeys/{questionId} {
        allow read, write: if isAdmin() || hasRole(['content_editor']);
      }
    }

    // AI Generation Jobs (Admin only)
    match /aiGenerationJobs/{jobId} {
      allow read, write: if isAdmin();
    }

    // Exam Templates (Admin only)
    match /examTemplates/{templateId} {
      allow read, write: if isAdmin();
    }

    // Exam attempts (Part F: Student cannot write score, status='submitted', or points. Cannot read other students' attempts)
    match /attempts/{attemptId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin() || hasRole(['support_agent']));
      
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.get('status', 'in_progress') == 'in_progress' &&
        !request.resource.data.keys().hasAny(['score', 'pointsEarned', 'correctCount', 'wrongCount', 'unansweredCount', 'reviews']);

      allow update: if isAdmin() || hasRole(['support_agent']) || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'in_progress' && (
          (
            request.resource.data.status == 'in_progress' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'score', 'pointsEarned', 'correctCount', 'correctAnswers', 'wrongCount', 'wrongAnswers', 'unansweredCount', 'unanswered', 'reviews', 'status', 'submittedAt'
            ])
          ) ||
          (
            request.resource.data.status == 'submitted_pending' &&
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              'score', 'pointsEarned', 'correctCount', 'correctAnswers', 'wrongCount', 'wrongAnswers', 'unansweredCount', 'unanswered', 'reviews'
            ])
          )
        )
      );
      
      allow delete: if isAdmin();

      // Student writes their selected answers to attempts/{attemptId}/answers while attempt is in_progress
      match /answers/{questionId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid ||
          isAdmin() ||
          hasRole(['support_agent'])
        );
        allow create, update: if isAuthenticated() && (
          isAdmin() ||
          hasRole(['support_agent']) ||
          (get(/databases/$(database)/documents/attempts/$(attemptId)).data.userId == request.auth.uid &&
           (get(/databases/$(database)/documents/attempts/$(attemptId)).data.status == 'in_progress' ||
            get(/databases/$(database)/documents/attempts/$(attemptId)).data.status == 'submitted_pending'))
        );
        allow delete: if false;
      }
    }
  }
}
